<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.qzb.springboot.mapper.SysTemplateMapper">
    <resultMap id="BaseResultMap" type="com.qzb.springboot.entity.SysTemplate">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="original_name" property="originalName"/>
        <result column="storage_name" property="storageName"/>
        <result column="file_path" property="filePath"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectByTenantId" resultMap="BaseResultMap">
        select * from sys_template where tenant_id = #{tenantId}
    </select>

    <select id="selectByTenantAndOriginal" resultMap="BaseResultMap">
        select * from sys_template where tenant_id = #{tenantId} and original_name = #{originalName}
    </select>

    <insert id="insert" parameterType="com.qzb.springboot.entity.SysTemplate" useGeneratedKeys="true" keyProperty="id">
        insert into sys_template (tenant_id, original_name, storage_name, file_path)
        values (#{tenantId}, #{originalName}, #{storageName}, #{filePath})
    </insert>

    <update id="updateByTenantAndOriginal" parameterType="com.qzb.springboot.entity.SysTemplate">
        update sys_template
        set storage_name = #{storageName}, file_path = #{filePath}
        where tenant_id = #{tenantId} and original_name = #{originalName}
    </update>

    <delete id="deleteByTenantAndOriginal">
        delete from sys_template where tenant_id = #{tenantId} and original_name = #{originalName}
    </delete>
</mapper>
    <select id="screenGetAllPlanByTenantAndTime" resultType="com.qzb.springboot.entity.Plan">
        select
        <include refid="Base_Column_List"></include>
        from plan
        join tenant on tenant.id = plan.tid
        join department on department.id = plan.did
        join user on user.id = plan.uid
        join sys_dict a on a.id = plan.attribute
        join sys_dict c on c.id = plan.type
        join sys_dict d on d.id = plan.imp
        join sys_dict e on e.id = plan.status
        where plan.tid = #{tid}
        and `isdelete` = '0'
        and isshow = '1'
        and e.value not in  ('已完成','已撤销')
        <!-- 核心修正：将 <= 替换为 &lt;=（XML实体转义） -->
        and DATEDIFF(STR_TO_DATE(plan.end_time, '%Y-%m-%d'), CURDATE()) &lt;= CAST(#{time} AS SIGNED)
        order by plan.create_time desc
    </select>

    <select id="selectPlanByIdsAndTid" resultType="com.qzb.springboot.entity.Plan">
        SELECT
        plan.id,plan.name,detail,a.`value` as attributeValue,attribute,
        start_time as startTime,end_time as endTime,
        plan.uid,plan.tid,plan.did,c.`value` as typeValue,type,head,
        d.`value` as impValue,imp,e.`value` as statusValue,plan.status,achievement,plan.create_time as createTime,
        plan.update_time as updateTime,user.name as username,tenant.name as tenant,department.name as department,`isdelete`,
        CASE WHEN plan.isopen = '1' THEN '公开' ELSE '私密' END as isopen,
        CASE WHEN plan.isshow = '1' THEN '是' ELSE '否' END as isshow
        from plan
        join tenant on tenant.id = plan.tid
        join department on department.id = plan.did
        join user on user.id = plan.uid
        join sys_dict a on a.id = plan.attribute
        join sys_dict c on c.id = plan.type
        join sys_dict d on d.id = plan.imp
        join sys_dict e on e.id = plan.status
        WHERE plan.id IN
        <foreach collection='ids' item='id' open='(' separator=',' close=')'>
            #{id}
        </foreach>
        AND plan.tid = #{tid}
        AND plan.isdelete = '0'
    </select>

    <!-- 各负责人的任务数聚合：AI按负责人筛选时列出真实有任务的负责人 -->
    <select id="countByHead" resultType="java.util.HashMap">
        select head, count(*) as cnt
        from plan
        where tid = #{tid} and isdelete = '0'
        group by head
        order by cnt desc
        limit #{limit}
    </select>

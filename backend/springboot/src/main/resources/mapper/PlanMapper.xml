    <select id="searchPlanByCondition" parameterType="com.qzb.springboot.entity.Plan" resultType="com.qzb.springboot.entity.Plan">
        select
        <include refid="Base_Column_List"></include>
        from plan
        join tenant on tenant.id = plan.tid
        join department on department.id = plan.did
        join user on user.id = plan.uid
        join sys_dict a on a.id = plan.attribute
<!--        join sys_dict b on b.id = plan.cycle-->
        join sys_dict c on c.id = plan.type
        join sys_dict d on d.id = plan.imp
        join sys_dict e on e.id = plan.status
        <where>
            <if test="id != null"> and plan.id= #{id}</if>
            <if test="tid != null"> and plan.tid= #{tid}</if>
            <if test="uid != null"> and plan.uid = #{uid}</if>
            <if test="did != null"> and plan.did = #{did}</if>
            <if test="name != null"> and plan.name like concat('%', #{name}, '%')</if>
            <if test="status != null"> and plan.status = #{status}</if>
            <!-- 新增：仅当status为null时，过滤未撤销数据 -->
            <if test="status == null"> and plan.status != '未撤销'</if>
            <if test="attribute != null"> and plan.attribute = #{attribute}</if>
<!--            <if test="cycle != null"> and plan.cycle = #{cycle}</if>-->
            <if test="type != null"> and plan.type = #{type}</if>
            <if test="head != null"> and plan.head = #{head}</if>
            <if test="imp != null"> and plan.imp = #{imp}</if>
            <if test="isopen != null"> and plan.isopen = #{isopen}</if>
            <if test="isshow != null"> and plan.isshow = #{isshow}</if>
            <if test="username != null"> and plan.username like concat('%', #{username}, '%')</if>
            <!-- ===================== 时间条件（纯String字符串比较） ===================== -->
            <!-- 传入开始时间不为空：计划结束时间 >= 传入开始时间 -->
            <if test="startTime != null and startTime != ''">
                and plan.end_time >= #{startTime}
            </if>
            <!-- 传入结束时间不为空：计划开始时间 <= 传入结束时间 -->
            <if test="endTime != null and endTime != ''">
                and plan.start_time &lt;= #{endTime}
            </if>
            and `isdelete` = '0'
        </where>
        order by plan.create_time desc
    </select>


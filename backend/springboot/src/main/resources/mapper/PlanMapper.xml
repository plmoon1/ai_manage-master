    <select id="getAllPlanByPerson" resultType="com.qzb.springboot.entity.Plan">
        select
            <include refid="Base_Column_List"></include>
        from plan
                 join tenant on tenant.id = plan.tid
                 join department on department.id = plan.did
                 join user on user.id = plan.uid
                 join sys_dict a on a.id = plan.attribute
<!--                 join sys_dict b on b.id = plan.cycle-->
                 join sys_dict c on c.id = plan.type
                 join sys_dict d on d.id = plan.imp
                 join sys_dict e on e.id = plan.status
        where plan.uid = #{uid} and `isdelete` = '0'
        order by plan.create_time desc
    </select>


    <select id="searchWorksByCondition" parameterType="com.qzb.springboot.entity.Works" resultType="com.qzb.springboot.entity.Works">
        select
        <include refid="Base_Column_List"></include>
        from works
        join tenant on tenant.id = works.tid
        join department on department.id = works.did
        join user on user.id = works.uid
<!--        join sys_dict a on a.id = works.attribute-->
        <!--        join sys_dict b on b.id = works.cycle-->
        join sys_dict c on c.id = works.type
<!--        join sys_dict d on d.id = works.imp-->
        join sys_dict e on e.id = works.status
        <where>
            <if test="id != null"> and works.id= #{id}</if>
            <if test="tid != null"> and works.tid= #{tid}</if>
            <if test="uid != null"> and works.uid = #{uid}</if>
            <if test="did != null"> and works.did = #{did}</if>
            <if test="name != null"> and works.name like concat('%', #{name}, '%')</if>
            <if test="status != null"> and works.status = #{status}</if>
<!--            <if test="attribute != null"> and works.attribute = #{attribute}</if>-->
            <!--            <if test="cycle != null"> and works.cycle = #{cycle}</if>-->
            <if test="type != null"> and works.type = #{type}</if>
            <if test="head != null"> and works.head = #{head}</if>
<!--            <if test="imp != null"> and works.imp = #{imp}</if>-->
            <if test="isopen != null"> and works.isopen = #{isopen}</if>
            <if test="isshow != null"> and works.isshow = #{isshow}</if>
            <if test="username != null"> and works.username like concat('%', #{username}, '%')</if>
            <!-- 时间条件（纯String字符串比较） -->
            <if test="startTime != null and startTime != ''">
                and works.end_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                and works.start_time &lt;= #{endTime}
            </if>
            and `isdelete` = '0'
        </where>
        order by works.create_time desc
    </select>


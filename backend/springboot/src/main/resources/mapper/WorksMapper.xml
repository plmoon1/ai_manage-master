    <select id="selectWorksByIdsAndTid" resultType="com.qzb.springboot.entity.Works">
        select works.name,
               detail,
               department.name as did,
               start_time as startTime,
               end_time as endTime,
               works.type,
               c.`value` as type_value,
              CASE WHEN works.isopen = '1' THEN '公开' ELSE '私密' END as isopen,
              CASE WHEN works.isshow = '1' THEN '是' ELSE '否' END as isshow,
               head,
               e.`value` as status,
               achievement
        from works
        join tenant on tenant.id = works.tid
        join department on department.id = works.did
        join user on user.id = works.uid
        join sys_dict c on c.id = works.type
        join sys_dict e on e.id = works.status
        WHERE works.id IN
        <foreach collection='ids' item='id' open='(' separator=',' close=')'>
            #{id}
        </foreach>
        AND works.tid = #{tid}
    </select>
</mapper>
    <!-- 结果映射 -->
    <resultMap id="SysDictResultMap" type="com.qzb.springboot.entity.SysDict">
        <id column="id" property="id"/>
        <result column="fid" property="fid"/>
        <result column="tid" property="tid"/>
        <result column="field" property="field"/>
        <result column="name" property="name"/>
        <result column="value" property="value"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, fid, tid, field, name,value
    </sql>

    <!-- 根据租户ID查询所有字典数据 -->
    <select id="getAllSysdicByTid" resultMap="SysDictResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_dict
        WHERE tid = #{tid}
        ORDER BY field, name
    </select>

    <!-- 根据ID查询字典 -->
    <select id="getSysDictById" resultMap="SysDictResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_dict
        WHERE id = #{id}
    </select>

    <!-- 根据父级ID查询所有下级字典 -->
    <select id="getSysDictByFid" resultMap="SysDictResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM sys_dict
        WHERE fid = #{fid} AND fid != id
    </select>

    <!-- 查询字典类型列表（去重） -->
    <select id="getDistinctFields" resultType="com.qzb.springboot.entity.SysDict">
        SELECT DISTINCT field,name
        FROM sys_dict
        WHERE tid = #{tid}
        ORDER BY field
    </select>

    <!-- 检查字典类型和名称是否已存在 -->
    <select id="checkDuplicate" resultType="int">
        SELECT COUNT(1)
        FROM sys_dict
        WHERE tid = #{tid}
        AND field = #{field}
        AND name = #{name}
        AND value = #{value}
        <if test="id != null and id != ''">
            AND id != #{id}
        </if>
    </select>

    <!-- 检查同一父节点下字典名称是否已存在 -->
    <!-- 2026-08-17 已废弃：被 checkDuplicateAmongSiblings 替代，保留SQL仅供回退 -->

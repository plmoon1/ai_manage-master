    <!-- 同级（兄弟节点）唯一性校验：根节点之间互为同级；非根节点同级=fid相同 -->
    <select id="checkDuplicateAmongSiblings" resultType="int">
        SELECT COUNT(1)
        FROM sys_dict
        WHERE tid = #{tid}
        AND field = #{field}
        AND `value` = #{value}
        AND id != #{excludeId}
        AND (
              (#{isRoot} = 1 AND fid = id)
           OR (#{isRoot} = 0 AND fid = #{fid} AND fid != id)
            )
    </select>

    <!-- 新增字典 -->
    <insert id="insertSysDict" parameterType="com.qzb.springboot.entity.SysDict">
        INSERT INTO sys_dict (id, fid, tid, field, name,value)
        VALUES (#{id}, #{fid}, #{tid}, #{field}, #{name},#{value})
    </insert>

    <!-- 更新字典 -->
    <update id="updateSysDict" parameterType="com.qzb.springboot.entity.SysDict">
        UPDATE sys_dict
        SET
        <if test="fid != null">
            fid = #{fid},
        </if>
        <if test="field != null and field != ''">
            field = #{field},
        </if>
        <if test="name != null and name != ''">
            name = #{name},
        </if>
        <if test="value != null and value != ''">
            value = #{value},
        </if>
        tid = #{tid}
        WHERE id = #{id}
    </update>

    <!-- 根据ID删除字典 -->
    <delete id="deleteSysDictById">
        DELETE FROM sys_dict WHERE id = #{id}
    </delete>

    <!-- 根据ID批量删除字典 -->
    <delete id="deleteSysDictByIds">
        DELETE FROM sys_dict WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="getIdByValue" resultType="java.lang.String">
        SELECT id
        FROM sys_dict
        WHERE tid = #{tid}
        AND field = #{field}
        AND value = #{value}
        LIMIT 1
    </select>


    <!-- 根据ID查节点 -->
    <select id="selectById" resultMap="SysDictResultMap">
        SELECT id, fid, tid, field, name, value
        FROM sys_dict
        WHERE id = #{id}
    </select>
    <!-- 根据父ID查子节点（排除根节点自身） -->
    <select id="selectChildrenByFid" resultMap="SysDictResultMap">
        SELECT id, fid, tid, field, name, value
        FROM sys_dict
        WHERE fid = #{fid}
          AND tid = #{tid}
          AND id != fid
    </select>

    <select id="getMeetingStatus" resultMap="SysDictResultMap">
        select * from sys_dict where field = 'meeting_status' and tid = #{tid}
    </select>


    <select id="selectByIdAndStatus" resultType="java.lang.String">
        SELECT id FROM sys_dict
        WHERE tid = #{tid}
          AND field = 'meeting_status'
          AND value = #{status}
            LIMIT 1
    </select>
</mapper>